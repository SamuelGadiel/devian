# Copie para .env e preencha (o .env NUNCA vai pro git — repo é público)
DEVIAN_API_TOKEN=troque-por-um-token-forte
DEVIAN_DATABASE_URL=postgresql+psycopg2://devian:SUA_SENHA@127.0.0.1:5434/devian
DEVIAN_CONTAINER_DEVIAN=devian
DEVIAN_CLAUDE_CMD=claude
DEVIAN_CLAUDE_TIMEOUT=300
DEVIAN_STORAGE_DIR=/home/ubuntu/devian/storage

# --- Auth (login com Google, sem Firebase) ---
# OAuth Client ID (tipo "Web application") criado no Google Cloud Console.
# O app Flutter usa o client ID Android no google_sign_in e passa este
# (Web) como serverClientId — o backend valida o ID token contra ele.
DEVIAN_GOOGLE_CLIENT_ID=
# Segredo que assina o JWT de sessão do Devian (gere com: openssl rand -hex 32)
DEVIAN_SESSION_JWT_SECRET=
# Duração da sessão em dias
DEVIAN_SESSION_TTL_DAYS=30
# CSV de e-mails autorizados a entrar (o primeiro login vira admin automaticamente)
# Vazio = ninguém além do primeiro usuário consegue entrar
DEVIAN_ALLOWED_LOGIN_EMAILS=
