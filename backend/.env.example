# Copie para .env e preencha (o .env NUNCA vai pro git — repo é público)
DEVIAN_DATABASE_URL=postgresql+psycopg2://devian:PASSWORD_HERE@127.0.0.1:5434/devian
DEVIAN_CONTAINER_DEVIAN=devian
DEVIAN_CLAUDE_CMD=claude
DEVIAN_CLAUDE_TIMEOUT=300
DEVIAN_STORAGE_DIR=/home/ubuntu/devian/storage

# --- Auth (e-mail + senha — o backend cuida do auth) ---
# Segredo que assina os JWT de acesso (gere com: openssl rand -hex 32)
DEVIAN_SESSION_JWT_SECRET=
# Validade do access token em minutos (default 60)
DEVIAN_ACCESS_TOKEN_TTL_MINUTES=60
# Validade do refresh token em dias (default 90)
DEVIAN_REFRESH_TOKEN_TTL_DAYS=90
