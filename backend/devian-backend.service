[Unit]
Description=Devian Hub API (FastAPI backend)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/devian/backend
ExecStart=/home/ubuntu/devian/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5
User=ubuntu
EnvironmentFile=/home/ubuntu/devian/backend/.env

[Install]
WantedBy=multi-user.target
