{"openapi":"3.0.3","info":{"title":"Devian Hub API","description":"\nAPI do hub do **Devian** — projetos, chats (Claude Code) e artefatos de build.\n\n**Autenticação:** todos os endpoints exigem um **Bearer token** (`DEVIAN_API_TOKEN`).\nClique em **Authorize** e cole o token, sem o prefixo `Bearer `.\nExceção: `GET /health`, que é público.\n","version":"0.5.5"},"servers":[{"url":"https://api.agapech.com.br/devian","description":"Produção — via túnel Cloudflare (oracle-hermi)"},{"url":"/devian","description":"Local — backend direto na porta 8088"}],"paths":{"/health":{"get":{"tags":["Health"],"summary":"Health check","description":"Usado por monitoramento e pelo app para checar conectividade com o hub.","operationId":"health_health_get","responses":{"200":{"description":"Serviço vivo. Sem autenticação (público).","content":{"application/json":{"schema":{}}}}}}},"/projects":{"get":{"tags":["Projects"],"summary":"List projects","operationId":"list_projects_projects_get","responses":{"200":{"description":"Lista de projetos (ordem alfabética)","content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/ProjectOut"},"type":"array","title":"Response List Projects Projects Get"}}}},"401":{"description":"Token Bearer ausente ou inválido","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorOut"}}}}},"security":[{"HTTPBearer":[]}]},"post":{"tags":["Projects"],"summary":"Create project","operationId":"create_project_projects_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectCreate"}}},"required":true},"responses":{"201":{"description":"Projeto criado","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectOut"}}}},"401":{"description":"Token Bearer ausente ou inválido","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorOut"}}}},"409":{"description":"Já existe um projeto com esse nome","content":{"application/json":{"schema":{"$ref":"#/componen